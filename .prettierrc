{
  "plugins": [
    "prettier-plugin-organize-attributes",
    "prettier-plugin-organize-imports",
    "prettier-plugin-tailwindcss"
  ],
  "organizeAttributes": {
    "order": ["*", "[*]", "(*)", "*:*"]
  },
  "attributeSort": "ASC",
  "importOrder": ["^@angular/(.*)$", "^rxjs$", "^[a-z]", "^@app/(.*)$", "^[./]"],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true,
  "singleQuote": true,
  "printWidth": 100,
  "semi": true,
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "overrides": [
    {
      "files": ["*.ts"],
      "options": {
        "parser": "typescript"
      }
    },
    {
      "files": ["*.component.ts"],
      "options": {
        "parser": "angular"
      }
    }
  ]
}
